# App
NODE_ENV=development
PORT=3000

# Postgres (consumed by docker-compose and the app)
POSTGRES_USER=apsara
POSTGRES_PASSWORD=apsara
POSTGRES_DB=apsara_wallet
POSTGRES_PORT=5432

# Full connection string used by the app + drizzle-kit
DATABASE_URL=postgres://apsara:apsara@localhost:5432/apsara_wallet

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Recurring materialization cron (hourly). Set to 'false' to fully disable it.
# Multi-instance is already safe — a Postgres advisory lock ensures only one
# instance materializes per tick — so you normally leave this on. Default: on.
RECURRING_SCHEDULER_ENABLED=true

# Push notifications (FCM). The full Firebase service-account JSON as a single
# line. Leave unset to disable push — the in-app inbox still works either way.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", ...}

# Password-reset email via Resend. Leave RESEND_API_KEY unset to disable email
# (dev returns the reset token in the response instead). RESEND_FROM must be a
# verified sender (or use onboarding@resend.dev for testing). PASSWORD_RESET_URL
# is the deep-link base the token is appended to.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Apsara Wallet <noreply@yourdomain.com>
# PASSWORD_RESET_URL=apsarawallet://reset-password?token=
