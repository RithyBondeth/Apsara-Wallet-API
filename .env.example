# App
NODE_ENV=development
PORT=3000

# Postgres (consumed by docker-compose and the app)
POSTGRES_USER=apsara
POSTGRES_PASSWORD=apsara
POSTGRES_DB=apsara_wallet
POSTGRES_PORT=5432

# Full connection string used by the app + drizzle-kit
DATABASE_URL=postgres://apsara:apsara@localhost:5432/apsara_wallet

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Recurring materialization cron (hourly). Set to 'false' to disable — e.g.
# when running multiple instances, so only one posts due entries. Default: on.
RECURRING_SCHEDULER_ENABLED=true
